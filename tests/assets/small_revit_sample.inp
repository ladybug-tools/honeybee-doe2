SET-DEFAULT FOR ZONE
   TYPE = CONDITIONED
   DESIGN-HEAT-T =
{switch(#LR("SPACE", "C-ACTIVITY-DESC"))
case "ElcM": 70.0
case "Rstr": 70.0
case "OpnO": 70.0
case "Crrd": 70.0
case "Strg": 70.0
default: no_default
endswitch}
..

SET-DEFAULT FOR ZONE
   TYPE = CONDITIONED
   DESIGN-COOL-T =
{switch(#LR("SPACE", "C-ACTIVITY-DESC"))
case "ElcM": 75.0
case "Rstr": 75.0
case "OpnO": 75.0
case "Crrd": 75.0
case "Strg": 75.0
default: no_default
endswitch}
..

SET-DEFAULT FOR ZONE
   TYPE = CONDITIONED
   HEAT-TEMP-SCH =
{switch(#LR("SPACE", "C-ACTIVITY-DESC"))
case "ElcM": #SI("OffcSmllHTGSETPSCHNOOPTIMUM", "ZONE", "HEAT-TEMP-SCH")
case "Rstr": #SI("OffcSmllHTGSETPSCHNOOPTIMUM", "ZONE", "HEAT-TEMP-SCH")
case "OpnO": #SI("OffcSmllHTGSETPSCHNOOPTIMUM", "ZONE", "HEAT-TEMP-SCH")
case "Crrd": #SI("OffcSmllHTGSETPSCHNOOPTIMUM", "ZONE", "HEAT-TEMP-SCH")
case "Strg": #SI("OffcSmllHTGSETPSCHNOOPTIMUM", "ZONE", "HEAT-TEMP-SCH")
default: no_default
endswitch}
..

SET-DEFAULT FOR ZONE
   TYPE = CONDITIONED
   COOL-TEMP-SCH =
{switch(#LR("SPACE", "C-ACTIVITY-DESC"))
case "ElcM": #SI("OffcSmllCLGSETPSCHNOOPTIMUM", "ZONE", "COOL-TEMP-SCH")
case "Rstr": #SI("OffcSmllCLGSETPSCHNOOPTIMUM", "ZONE", "COOL-TEMP-SCH")
case "OpnO": #SI("OffcSmllCLGSETPSCHNOOPTIMUM", "ZONE", "COOL-TEMP-SCH")
case "Crrd": #SI("OffcSmllCLGSETPSCHNOOPTIMUM", "ZONE", "COOL-TEMP-SCH")
case "Strg": #SI("OffcSmllCLGSETPSCHNOOPTIMUM", "ZONE", "COOL-TEMP-SCH")
default: no_default
endswitch}
..

SET-DEFAULT FOR ZONE
   TYPE = CONDITIONED
   OA-FLOW/PER =
{switch(#LR("SPACE", "C-ACTIVITY-DESC"))
case "OpnO": 5.0
default: no_default
endswitch}
..

SET-DEFAULT FOR ZONE
   TYPE = CONDITIONED
   OA-FLOW/AREA =
{switch(#LR("SPACE", "C-ACTIVITY-DESC"))
case "ElcM": 0.12
case "Rstr": 0.06
case "OpnO": 0.06
case "Crrd": 0.06
case "Strg": 0.12
default: no_default
endswitch}
..

SET-DEFAULT FOR ZONE
   TYPE = CONDITIONED
   MIN-FLOW-SCH =
{switch(#LR("SPACE", "C-ACTIVITY-DESC"))
case "ElcM": #SI("Always On", "ZONE", "MIN-FLOW-SCH")
case "Rstr": #SI("Always On", "ZONE", "MIN-FLOW-SCH")
case "OpnO": #SI("Always On", "ZONE", "MIN-FLOW-SCH")
case "Crrd": #SI("Always On", "ZONE", "MIN-FLOW-SCH")
case "Strg": #SI("Always On", "ZONE", "MIN-FLOW-SCH")
default: no_default
endswitch}
..

