$ ---------------------------------------------------------
$              Title, Run Periods, Design Days, Holidays
$ ---------------------------------------------------------


TITLE
   LINE-1           = *Unnamed*
   ..

"Default Run Period" = RUN-PERIOD-PD
   BEGIN-MONTH              = 1
   BEGIN-DAY                = 1
   BEGIN-YEAR               = 2021
   END-MONTH                = 12
   END-DAY                  = 31
   END-YEAR                 = 2021
   ..
"Standard US Holidays" = HOLIDAYS
   LIBRARY-ENTRY            = "US"
   ..

